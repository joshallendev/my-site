		"autoprefixer": "^10.4.4",
		"eslint": "^9.0.0",
		"eslint-config-prettier": "^8.3.0",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"postcss": "^8.4.12",
		"prettier": "^3.0.0",
		"prettier-plugin-svelte": "^3.0.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^3.0.23",
		"tslib": "^2.3.1",
